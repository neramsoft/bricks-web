# The Bricks website. Copy to .env.local (or set in the process environment).
# Nothing here is a secret except REVALIDATE_SECRET; never commit a real value.

# The ProBiz CMS API's base address, without /v1. Server side only (an internal address in
# production). Required in production; in development it defaults to http://localhost:3001.
API_URL=http://localhost:3001

# The API's address as the visitor's browser reaches it (https://api.bricks.ba): table ordering
# (/s/<token>) sends orders from the browser straight to it, so each guest has their own address in
# the API's rate limits (the API's CORS must allow SITE_URL), and an event's "Dodaj u kalendar" file
# is linked to it. Server side only, handed to the page at run time (no NEXT_PUBLIC, one image
# serves any install). Defaults to API_URL, so set it when API_URL is an internal address.
PUBLIC_API_URL=

# The public origin of the site: canonical addresses, hreflang, the sitemap and JSON-LD.
# Required in production; in development it defaults to http://localhost:3000.
SITE_URL=http://localhost:3000

# The website connection's signing secret (whsec_...), shown once in the CMS admin under
# Settings, Website connection ("Generate secret"). It verifies the CMS's revalidation webhook and
# signs what the site sends to the CMS. Optional; never sent to a browser.
REVALIDATE_SECRET=

# Optional: the host that serves the media files, when it is not the API's (the S3 or CDN address).
# next/image may only fetch from the API's host and this one.
MEDIA_PUBLIC_URL=

# How many reverse proxies in front of the site append to X-Forwarded-For (0 to 5; Caddy: 1).
# 0 (the default) trusts no header.
TRUSTED_PROXY_HOPS=0
