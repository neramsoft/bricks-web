# The Bricks website's settings on the server: copy to /srv/probiz/sites/bricks/.env (chmod 600) and
# fill in (docs/runbook/deploy.md). The only secret is REVALIDATE_SECRET; never commit a real value.

# The site's domain, without https://. Used by deploy-site for its smoke request. It is also the CMS's
# SITE_HOST, which Caddy reads for bricks.caddy.
SITE_HOST=bricks.ba

# The CMS API's public address, not http://api:3001: the website's container is on the edge network and
# `api` is not (ProBiz CMS docs/runbook/client-site.md). The same path a browser takes.
API_URL=https://api.bricks.ba

# The API as the visitor's browser reaches it: table ordering (/s/<token>) sends orders from the
# browser to it, and its CORS must allow SITE_URL.
PUBLIC_API_URL=https://api.bricks.ba

# The public origin of the site: canonical addresses, hreflang, the sitemap and JSON-LD.
SITE_URL=https://bricks.ba

# The host that serves the media files (the CMS's MEDIA_PUBLIC_URL); next/image may fetch only from here
# and from the API's host.
MEDIA_PUBLIC_URL=https://media.bricks.ba

# The signing secret of the CMS's website connection (whsec_...): in https://admin.bricks.ba, Settings,
# Website connection, enter https://bricks.ba and "Generate secret", then paste the same value here.
REVALIDATE_SECRET=

# One proxy (Caddy) appends to X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# SITE_RELEASE is not set here: `deploy-site bricks X.Y.Z` writes it into .env at every deploy and puts
# the old one back when a deploy fails. Do not edit it by hand.

# Optional, not needed on a standard install:
# The memory limit of the container (the in-memory caches count against it).
#SITE_MEMORY=1g
# The CMS's edge network, when its .env sets another EDGE_NETWORK.
#EDGE_NETWORK=probiz-edge
