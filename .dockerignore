# What never goes into an image build context. The Dockerfile copies named files and folders only;
# this is the second lock, for a `COPY . .` somebody adds later.

# Secrets and local state
.env
.env.*
!.env.example
**/*.pem
**/*.key

# Not needed to build (unit tests import test/fixtures, which is not copied; next build type-checks every .ts it finds)
**/*.test.ts
**/*.test.tsx
test
e2e
vitest.config.ts
playwright.config.ts
.git
.github
.claude
.vscode
.idea
docs
design
node_modules
.next
coverage
test-results
playwright-report
*.tsbuildinfo
